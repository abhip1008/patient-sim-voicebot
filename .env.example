# ─────────────────────────────────────────────────────────────
# Patient Simulator Voice Bot — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # your purchased Twilio Voice number, E.164 — the ONE number you test from
TARGET_NUMBER=+18054398008  # Pretty Good AI assessment line — the ONLY number you call
PUBLIC_BASE_URL=            # your ngrok https URL, e.g. https://xxxx.ngrok-free.app

# Speech-to-text
DEEPGRAM_API_KEY=

# LLM (the patient brain)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# Text-to-speech (Cartesia)
CARTESIA_API_KEY=
TTS_VOICE_ID=

# Optional
LOG_LEVEL=INFO
